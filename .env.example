# --- Used by Docker Compose (read automatically from a root .env) ---
# All of these are optional. Defaults work out of the box.
DB_PASSWORD=tesla_dev_password
JWT_SECRET=change-me-to-a-long-random-string
# DB_HOST=host.docker.internal
# NEXT_PUBLIC_API_BASE=http://localhost:4000

# --- Used only when running the API directly on your machine (no Docker) ---
# Copy this file to api/.env for that. localhost is correct here because the
# API runs on the host and reaches Postgres through the published port.
DATABASE_URL=postgresql://tesla:tesla_dev_password@localhost:5432/tesla_pool
PORT=4000
